PORT=3000

# ---------- Database (PostgreSQL 18) ----------
# Copy file này thành .env rồi điền giá trị thật. File .env đã bị git bỏ qua,
# KHÔNG đưa giá trị thật vào mã nguồn hay vào file này.
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Tên database và role dùng cho ứng dụng: chữ thường, số, gạch dưới.
DATABASE_NAME=rental_management
DATABASE_USER=rental_app
# Mật khẩu của role ứng dụng, từ 16 ký tự, không được để CHANGE_ME.
# Gợi ý: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DATABASE_PASSWORD=CHANGE_ME
DATABASE_POOL_MAX=10

# Chỉ dùng cho `npm run db:create` (tạo role và database). Ứng dụng không đọc hai biến này.
# Điền mật khẩu tài khoản quản trị của PostgreSQL đã cài trên máy.
DATABASE_ADMIN_USER=postgres
DATABASE_ADMIN_PASSWORD=CHANGE_ME

# ---------- Đăng nhập ----------
# Chuỗi ngẫu nhiên từ 32 ký tự, không được để CHANGE_ME.
# Gợi ý: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1d
