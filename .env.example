PORT=3000

# ---------- Database (PostgreSQL 18) ----------
# Copy file này thành .env rồi điền giá trị thật. File .env đã bị git bỏ qua,
# KHÔNG đưa giá trị thật vào mã nguồn hay vào file này.
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Tên database và role dùng cho ứng dụng: chữ thường, số, gạch dưới.
DATABASE_NAME=rental_management
DATABASE_USER=rental_app
# Mật khẩu của role ứng dụng, từ 16 ký tự, không được để CHANGE_ME.
# Gợi ý: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DATABASE_PASSWORD=CHANGE_ME
DATABASE_POOL_MAX=10

# Chỉ dùng cho `npm run db:create` (tạo role và database). Ứng dụng không đọc hai biến này.
# Điền mật khẩu tài khoản quản trị của PostgreSQL đã cài trên máy.
DATABASE_ADMIN_USER=postgres
DATABASE_ADMIN_PASSWORD=CHANGE_ME

# ---------- Token (spec 0002) ----------
# Chuỗi ngẫu nhiên từ 32 ký tự, không được để CHANGE_ME.
# Gợi ý: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ISSUER=rental-api
JWT_AUDIENCE=rental-web
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_GRACE_SECONDS=10
MAX_SESSIONS_PER_USER=10
REFRESH_COOKIE_NAME=rt
# false khi chạy http://localhost; true khi có HTTPS
COOKIE_SECURE=false
# Origin của FE, cách nhau bởi dấu phẩy, KHÔNG có dấu / cuối. Dùng host "localhost" ở cả FE lẫn API.
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# ---------- Quên mật khẩu và email (spec 0002 AC-8) ----------
# Địa chỉ FE, KHÔNG có dấu / cuối. Liên kết trong email dẫn tới <APP_BASE_URL>/reset-password?token=...
APP_BASE_URL=http://localhost:5173
# Liên kết đặt lại mật khẩu hết hạn sau số phút này.
PASSWORD_RESET_TTL_MINUTES=30
# Gmail SMTP: cổng 465 dùng TLS ngay từ đầu; cổng khác (587) nâng cấp lên TLS giữa chừng.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# Địa chỉ Gmail dùng để gửi.
MAIL_USER=CHANGE_ME
# App Password của Gmail (Tài khoản Google > Bảo mật > Mật khẩu ứng dụng), KHÔNG phải mật khẩu đăng nhập Gmail.
MAIL_PASSWORD=CHANGE_ME
# Người gửi hiển thị trong thư: địa chỉ email, hoặc dạng Tên hiển thị <địa chỉ email>.
MAIL_FROM=CHANGE_ME

# ---------- Ảnh tin (spec 0002 AC-8, spec 0006) ----------
# Thư mục lưu ảnh tải lên. Đường dẫn tương đối tính từ thư mục chạy ứng dụng; thư mục này đã được .gitignore.
# Docker Compose đặt /data/uploads. Không đặt thì dùng "uploads".
UPLOAD_DIR=uploads
# Dung lượng tối đa mỗi ảnh, tính bằng byte (từ 1 đến 10485760). Không đặt thì dùng 5242880 (5 MiB).
MAX_UPLOAD_BYTES=5242880

# ---------- Chỉ dùng cho `npm run seed` (ứng dụng không đọc) ----------
# Tài khoản admin đầu tiên (spec 0003). Mật khẩu từ 8 ký tự, không được để CHANGE_ME.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME
ADMIN_SEED_NAME=Quản trị viên

# ---------- Chỉ dùng cho `npm run seed:demo` (ứng dụng không đọc) ----------
# Mật khẩu chung của mọi tài khoản demo (bộ dữ liệu mẫu cho FE làm việc). Từ 8 ký tự, không được để CHANGE_ME.
# Lệnh này từ chối chạy khi NODE_ENV=production. Ảnh demo ghi vào UPLOAD_DIR ở trên.
DEMO_SEED_PASSWORD=CHANGE_ME
