# Mẫu cấu hình cho máy chủ (compose.yaml). Dùng thay `.env.example` (file đó dành cho máy dev).
#
#   cp .env.production.example .env
#   chmod 600 .env          # chỉ chủ file đọc được
#
# `.env` đã bị git bỏ qua. KHÔNG đưa giá trị thật vào mã nguồn hay vào file mẫu này.
# Compose đọc file này để điền giá trị cho từng service; thiếu biến bắt buộc thì `docker compose` dừng ngay
# với thông báo rõ. Mọi giá trị CHANGE_ME phải được thay, API từ chối khởi động nếu còn sót.
#
# Sinh chuỗi ngẫu nhiên (chạy trên máy chủ, cần Docker):
#   docker run --rm node:24-bookworm-slim node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# Chuỗi base64url chỉ có chữ, số, '-' và '_': an toàn khi để trong .env mà không cần dấu nháy.

# ---------- Địa chỉ công khai (nginx, HTTPS) ----------
# Origin của FE, KHÔNG có dấu / cuối. Khớp CHÍNH XÁC địa chỉ người dùng gõ trên trình duyệt (cả http/https).
# Dùng làm danh sách CORS và để chặn CSRF ở /auth/refresh và /auth/logout.
ALLOWED_ORIGINS=https://rental.example.com
# Liên kết đặt lại mật khẩu trong email dẫn tới <APP_BASE_URL>/reset-password?token=...
APP_BASE_URL=https://rental.example.com
# Cookie refresh chỉ đi qua HTTPS. Đặt false chỉ khi thử qua http (không dùng ở máy chủ thật).
COOKIE_SECURE=true
# Số lớp proxy tin cậy để đọc IP khách (giới hạn tần suất đếm theo IP). 1 = chỉ nginx đứng trước API.
# Đặt 0 sẽ khiến mọi khách dùng chung một IP (IP của nginx). Thêm Cloudflare hay proxy phía trước nginx thì VẪN để 1 và
# cho nginx đọc IP thật bằng module realip (xem hướng dẫn, mục 5a): nginx ghi đè X-Forwarded-For bằng IP đó.
TRUST_PROXY_HOPS=1
# Cổng trên máy chủ (chỉ mở ở 127.0.0.1); nginx proxy tới cổng này.
API_PORT=3000
# Nhãn image (đặt theo phiên bản/ngày để quay lại bản cũ được).
API_TAG=local

# ---------- Database ----------
# Mật khẩu superuser `postgres`. Chỉ dùng để quản trị bằng `docker compose exec db psql`; API KHÔNG nhận biến này.
POSTGRES_PASSWORD=CHANGE_ME
# Role và database của ứng dụng (role không phải superuser). Chữ thường, số, gạch dưới.
# Script khởi tạo chỉ chạy lần đầu (khi volume pgdata còn trống): đổi ba giá trị này SAU đó không có tác dụng với database cũ.
APP_DB_NAME=rental_management
APP_DB_USER=rental_app
APP_DB_PASSWORD=CHANGE_ME
DATABASE_POOL_MAX=10

# ---------- Token ----------
# Chuỗi ngẫu nhiên từ 32 ký tự. Đổi giá trị này làm mọi access token đang dùng mất hiệu lực.
JWT_ACCESS_SECRET=CHANGE_ME
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# ---------- Email (quên mật khẩu) ----------
# Gmail SMTP: cổng 465 dùng TLS ngay từ đầu. MAIL_PASSWORD là App Password, KHÔNG phải mật khẩu Gmail.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=CHANGE_ME
PASSWORD_RESET_TTL_MINUTES=30

# ---------- Ảnh tin ----------
# Dung lượng tối đa mỗi ảnh (byte, tối đa 10485760). Mỗi lần đăng tối đa 5 ảnh: nếu tăng số này,
# tăng `client_max_body_size` trong deploy/nginx/rental.conf cho khớp (5 x giá trị này, cộng dư).
MAX_UPLOAD_BYTES=5242880

# ---------- Admin đầu tiên (chỉ migrate/seed đọc, API không nhận) ----------
# Chỉ dùng khi database CHƯA có admin nào. Sau lần chạy đầu: đăng nhập, ĐỔI mật khẩu trong ứng dụng.
# Biến vẫn phải điền hợp lệ ở các lần `up` sau (seed kiểm tra định dạng) nhưng giá trị không còn được dùng.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME
ADMIN_SEED_NAME=Quản trị viên

# ---------- Dữ liệu demo cho FE (tùy chọn; chỉ service `demo-seed` đọc, API không nhận) ----------
# Mật khẩu CHUNG của mọi tài khoản demo (@demo.example.com), từ 8 ký tự. Chỉ điền khi bạn nạp dữ liệu demo:
#   docker compose --profile demo run --rm demo-seed            # lần đầu
#   docker compose --profile demo run --rm demo-seed --reset    # làm mới
# Trên máy chủ công khai hãy dùng chuỗi dài, không đoán được (ai biết nó đăng nhập được mọi tài khoản demo).
# Để CHANGE_ME khi không dùng.
DEMO_SEED_PASSWORD=CHANGE_ME
