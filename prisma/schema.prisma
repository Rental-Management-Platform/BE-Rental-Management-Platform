// Schema duy nhất của ứng dụng (spec 0001, mục "Lớp truy cập dữ liệu", và spec 0005).
// Quy ước: tên bảng và cột snake_case ghi rõ bằng @@map và @map; ràng buộc và chỉ mục đặt
// tên rõ qua tham số map. CHECK và chỉ mục một phần viết bằng SQL trong file migration
// (Prisma bỏ qua chúng, đã kiểm chứng); chỉ mục GIN khai báo ở đây.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  // uuidv7() có sẵn từ PostgreSQL 18; id sắp theo thời gian nên chỉ mục không bị phân mảnh.
  id                String    @id(map: "users_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  email             String    @unique(map: "users_email_unique")
  passwordHash      String    @map("password_hash")
  name              String?
  /// Số điện thoại đã chuẩn hóa (spec 0002 AC-13). Bắt buộc với landlord (CHECK ở migration);
  /// chỉ mục duy nhất một phần cho landlord cũng nằm ở migration (Prisma bỏ qua nó).
  phone             String?
  /// Loại tài khoản, đặt lúc đăng ký và không đổi sau đó (spec 0003).
  accountType       String    @map("account_type")
  status            String    @default("active")
  /// Chỉ có giá trị khi đang bị khóa; lý do khóa và mở khóa lưu ở moderation_logs.
  lockedReason      String?   @map("locked_reason")
  /// Lần gần nhất đổi hoặc đặt lại mật khẩu (spec 0002); rỗng nếu chưa từng đổi.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  accountTypeRef AccountType     @relation(fields: [accountType], references: [key], onDelete: Restrict, map: "users_account_type_fk")
  sessions       AuthSession[]
  moderationLogs ModerationLog[]
  passwordResets PasswordReset[]

  @@index([accountType], map: "users_account_type_idx")
  @@map("users")
}

/// Đúng ba dòng admin, landlord, tenant, do migration chèn sẵn; không có đường thêm hay xóa dòng (spec 0003).
model AccountType {
  /// CHECK ở migration: chỉ nhận admin, landlord, tenant.
  key         String   @id(map: "account_types_pkey")
  name        String
  description String?
  /// Khóa quyền dạng module:action. Với admin để mảng rỗng và bị bỏ qua: quyền admin tính trong code.
  /// DB không kiểm được danh mục (nằm trong code) nên Service kiểm khi ghi và lọc khi đọc.
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("account_types")
}

/// Lịch sử kiểm duyệt, chỉ thêm không sửa (BR-13, spec 0003 AC-7): khóa, mở khóa và các hành động duyệt về sau.
model ModerationLog {
  id         String   @id(map: "moderation_logs_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  action     String
  reason     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, map: "moderation_logs_actor_id_fk")

  @@index([targetType, targetId, createdAt], map: "moderation_logs_target_idx")
  @@map("moderation_logs")
}

/// Mỗi lần đăng nhập là một dòng. Refresh token chỉ lưu bản băm SHA-256 (spec 0002).
model AuthSession {
  /// Chính là `sid` trong access token.
  id                String    @id(map: "auth_sessions_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) của refresh token hiện hành. Duy nhất toàn bảng.
  tokenHash         String    @unique(map: "auth_sessions_token_hash_unique") @map("token_hash")
  /// Bản băm của token liền trước, để cho khoảng ân hạn và nhận ra "dùng lại token đã xoay".
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(6)
  /// Hết hạn tuyệt đối: REFRESH_TTL_DAYS ngày kể từ lúc đăng nhập.
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// CHECK ở migration: logout, logout_all, reuse_detected, password_changed, locked, admin_revoked, session_limit.
  revokedReason     String?   @map("revoked_reason")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fk")

  @@index([userId, revokedAt], map: "auth_sessions_user_id_revoked_at_idx")
  @@index([previousTokenHash], map: "auth_sessions_previous_token_hash_idx")
  @@map("auth_sessions")
}

/// Liên kết đặt lại mật khẩu, dùng một lần. Chỉ lưu bản băm SHA-256 của token (spec 0002 AC-8, AC-12).
model PasswordReset {
  id        String    @id(map: "password_resets_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) của token gửi trong email. Duy nhất toàn bảng.
  tokenHash String    @unique(map: "password_resets_token_hash_unique") @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Có giá trị khi đã dùng. Liên kết cũ bị thay bằng liên kết mới thì bị xóa chứ không đánh dấu.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "password_resets_user_id_fk")

  @@index([userId], map: "password_resets_user_id_idx")
  @@map("password_resets")
}
