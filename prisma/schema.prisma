// Schema duy nhất của ứng dụng (spec 0001, mục "Lớp truy cập dữ liệu", và spec 0005).
// Quy ước: tên bảng và cột snake_case ghi rõ bằng @@map và @map; ràng buộc và chỉ mục đặt
// tên rõ qua tham số map. CHECK và chỉ mục một phần viết bằng SQL trong file migration
// (Prisma bỏ qua chúng, đã kiểm chứng); chỉ mục GIN khai báo ở đây.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  // uuidv7() có sẵn từ PostgreSQL 18; id sắp theo thời gian nên chỉ mục không bị phân mảnh.
  id                String    @id(map: "users_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  email             String    @unique(map: "users_email_unique")
  passwordHash      String    @map("password_hash")
  name              String?
  /// Số điện thoại đã chuẩn hóa (spec 0002 AC-13). Bắt buộc với landlord (CHECK ở migration);
  /// chỉ mục duy nhất một phần cho landlord cũng nằm ở migration (Prisma bỏ qua nó).
  phone             String?
  /// Loại tài khoản, đặt lúc đăng ký và không đổi sau đó (spec 0003).
  accountType       String    @map("account_type")
  status            String    @default("active")
  /// Chỉ có giá trị khi đang bị khóa; lý do khóa và mở khóa lưu ở moderation_logs.
  lockedReason      String?   @map("locked_reason")
  /// Lần gần nhất đổi hoặc đặt lại mật khẩu (spec 0002); rỗng nếu chưa từng đổi.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  /// Hết kỳ dùng thử của chủ trọ, đặt lúc đăng ký (spec 0003 dùng thử). Bắt buộc với landlord (CHECK ở migration);
  /// rỗng với tenant và admin.
  trialEndsAt       DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  accountTypeRef  AccountType     @relation(fields: [accountType], references: [key], onDelete: Restrict, map: "users_account_type_fk")
  sessions        AuthSession[]
  moderationLogs  ModerationLog[]
  passwordResets  PasswordReset[]
  properties      Property[]
  updatedSettings Setting[]

  @@index([accountType], map: "users_account_type_idx")
  @@map("users")
}

/// Đúng ba dòng admin, landlord, tenant, do migration chèn sẵn; không có đường thêm hay xóa dòng (spec 0003).
model AccountType {
  /// CHECK ở migration: chỉ nhận admin, landlord, tenant.
  key         String   @id(map: "account_types_pkey")
  name        String
  description String?
  /// Khóa quyền dạng module:action. Với admin để mảng rỗng và bị bỏ qua: quyền admin tính trong code.
  /// DB không kiểm được danh mục (nằm trong code) nên Service kiểm khi ghi và lọc khi đọc.
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("account_types")
}

/// Lịch sử kiểm duyệt, chỉ thêm không sửa (BR-13, spec 0003 AC-7): khóa, mở khóa và các hành động duyệt về sau.
model ModerationLog {
  id         String   @id(map: "moderation_logs_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  action     String
  reason     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict, map: "moderation_logs_actor_id_fk")

  @@index([targetType, targetId, createdAt], map: "moderation_logs_target_idx")
  @@map("moderation_logs")
}

/// Mỗi lần đăng nhập là một dòng. Refresh token chỉ lưu bản băm SHA-256 (spec 0002).
model AuthSession {
  /// Chính là `sid` trong access token.
  id                String    @id(map: "auth_sessions_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) của refresh token hiện hành. Duy nhất toàn bảng.
  tokenHash         String    @unique(map: "auth_sessions_token_hash_unique") @map("token_hash")
  /// Bản băm của token liền trước, để cho khoảng ân hạn và nhận ra "dùng lại token đã xoay".
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(6)
  /// Hết hạn tuyệt đối: REFRESH_TTL_DAYS ngày kể từ lúc đăng nhập.
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// CHECK ở migration: logout, logout_all, reuse_detected, password_changed, locked, admin_revoked, session_limit.
  revokedReason     String?   @map("revoked_reason")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fk")

  @@index([userId, revokedAt], map: "auth_sessions_user_id_revoked_at_idx")
  @@index([previousTokenHash], map: "auth_sessions_previous_token_hash_idx")
  @@map("auth_sessions")
}

/// Liên kết đặt lại mật khẩu, dùng một lần. Chỉ lưu bản băm SHA-256 của token (spec 0002 AC-8, AC-12).
model PasswordReset {
  id        String    @id(map: "password_resets_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) của token gửi trong email. Duy nhất toàn bảng.
  tokenHash String    @unique(map: "password_resets_token_hash_unique") @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Có giá trị khi đã dùng. Liên kết cũ bị thay bằng liên kết mới thì bị xóa chứ không đánh dấu.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "password_resets_user_id_fk")

  @@index([userId], map: "password_resets_user_id_idx")
  @@map("password_resets")
}

/// Phường, xã, đặc khu theo địa chỉ hai cấp sau sáp nhập (tỉnh hoặc thành phố, rồi phường hoặc xã); không còn quận huyện.
/// Dữ liệu seed ở prisma/seed-data/wards.json (spec 0002, spec 0005). Admin thêm, sửa tên, xóa được.
model Ward {
  /// Mã 5 chữ số của đơn vị hành chính (đã đổi theo Quyết định 19/2025/QĐ-TTg).
  code         String   @id(map: "wards_pkey")
  /// Tên đầy đủ kèm loại đơn vị, ví dụ "Phường Bến Thành", "Xã Bình Chánh", "Đặc khu Côn Đảo".
  name         String
  /// Mã tỉnh hoặc thành phố; TP. Hồ Chí Minh là 79.
  provinceCode String   @map("province_code")
  provinceName String   @map("province_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  properties Property[]

  @@map("wards")
}

/// Tiện ích của nhà trọ (wifi, máy lạnh...). CHECK ở migration: key dạng ^[a-z][a-z0-9_]{1,29}$.
model Amenity {
  key       String   @id(map: "amenities_pkey")
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  properties PropertyAmenity[]

  @@map("amenities")
}

/// Nhà trọ: nơi giữ địa chỉ, phí và tiện ích; mỗi tin phòng thuộc một nhà trọ. Xóa mềm.
/// Địa chỉ gồm số nhà và đường (addressText) cộng phường hoặc xã (ward); tỉnh hoặc thành phố lấy từ ward.
model Property {
  id          String    @id(map: "properties_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  landlordId  String    @map("landlord_id") @db.Uuid
  name        String
  /// Số nhà và tên đường, KHÔNG gồm phường, xã, tỉnh (đã nằm ở ward).
  addressText String    @map("address_text")
  wardCode    String    @map("ward_code")
  /// Cả hai cùng rỗng hoặc cùng có (CHECK ở migration); vĩ độ trong [-90, 90], kinh độ trong [-180, 180].
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  landlord  User              @relation(fields: [landlordId], references: [id], onDelete: Restrict, map: "properties_landlord_id_fk")
  ward      Ward              @relation(fields: [wardCode], references: [code], onDelete: Restrict, map: "properties_ward_code_fk")
  fees      PropertyFee[]
  amenities PropertyAmenity[]
  listings  Listing[]

  @@index([landlordId], map: "properties_landlord_id_idx")
  @@index([wardCode], map: "properties_ward_code_idx")
  @@map("properties")
}

/// Khoản phí của nhà trọ, tối đa một khoản cho mỗi loại (UNIQUE) nên tối đa 6 dòng.
model PropertyFee {
  id         String  @id(map: "property_fees_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  /// CHECK ở migration: electricity, water, internet, parking, service, other.
  kind       String
  /// Đơn giá, đồng Việt Nam (CHECK price >= 0).
  price      Int
  /// CHECK ở migration: per_kwh, per_m3, per_month, per_person_month, per_vehicle_month.
  unit       String
  note       String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "property_fees_property_id_fk")

  @@unique([propertyId, kind], map: "property_fees_property_id_kind_unique")
  @@map("property_fees")
}

model PropertyAmenity {
  propertyId String @map("property_id") @db.Uuid
  amenityKey String @map("amenity_key")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "property_amenities_property_id_fk")
  amenity  Amenity  @relation(fields: [amenityKey], references: [key], onDelete: Restrict, map: "property_amenities_amenity_key_fk")

  @@id([propertyId, amenityKey], map: "property_amenities_pkey")
  @@index([amenityKey], map: "property_amenities_amenity_key_idx")
  @@map("property_amenities")
}

/// Tin phòng thuộc một nhà trọ (spec 0002). Sinh ra là `visible`; không nháp, không duyệt. Xóa mềm.
/// Điều kiện hiển thị công khai là phép nối với nhà trọ và chủ trọ, viết một lần ở Repository (không cờ sao chép).
model Listing {
  id            String    @id(map: "listings_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  propertyId    String    @map("property_id") @db.Uuid
  /// Mã ngắn 8 ký tự do Service sinh, dùng ở đường dẫn công khai `slug-mã`.
  code          String    @unique(map: "listings_code_unique")
  title         String
  description   String
  /// Giá thuê mỗi tháng, đồng (CHECK price > 0).
  price         Int
  areaM2        Float     @map("area_m2")
  deposit       Int?
  availableFrom DateTime? @map("available_from") @db.Date
  /// CHECK ở migration: visible, hidden_by_owner, hidden_by_admin.
  status        String    @default("visible")
  /// Chỉ tăng, qua một câu UPDATE nguyên tử (spec 0002 AC-13).
  viewCount     Int       @default(0) @map("view_count")
  /// Dẫn xuất: toSearchKey(tiêu đề, tên nhà trọ, địa chỉ, tên phường). Ba đường cập nhật duy nhất (spec 0002).
  searchKey     String    @map("search_key")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict, map: "listings_property_id_fk")
  images   ListingImage[]

  // Hai chỉ mục một phần (created_at DESC, id DESC) và (price, id) cho điều kiện hiển thị viết SQL ở migration.
  @@index([propertyId], map: "listings_property_id_idx")
  @@index([searchKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "listings_search_key_gin")
  @@map("listings")
}

/// Ảnh của tin, tối đa 5 (CHECK position BETWEEN 0 AND 4 cộng UNIQUE). Vị trí nhỏ nhất là ảnh bìa.
model ListingImage {
  id         String   @id(map: "listing_images_pkey") @default(dbgenerated("uuidv7()")) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  position   Int      @db.SmallInt
  /// Khóa lưu trữ do server sinh, dạng public/<uuid>.<jpg|png|webp>.
  storageKey String   @unique(map: "listing_images_storage_key_unique") @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade, map: "listing_images_listing_id_fk")

  @@unique([listingId, position], map: "listing_images_listing_id_position_unique")
  @@map("listing_images")
}

/// Tham số nghiệp vụ admin chỉnh được (spec 0003 dùng thử). Khóa hợp lệ do code đăng ký (SETTING_DEFINITIONS);
/// giá trị lưu dạng chữ, được ép số nguyên và kiểm khoảng mỗi lần đọc. CHECK ở migration: key dạng ^[a-z][a-z0-9_]{1,59}$.
model Setting {
  key       String   @id(map: "settings_pkey")
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Admin sửa lần cuối; rỗng khi dòng do seed tạo hoặc admin đó đã bị xóa.
  updatedBy String?  @map("updated_by") @db.Uuid

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull, map: "settings_updated_by_fk")

  @@map("settings")
}
